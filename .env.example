GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Databases (PostgreSQL + pgvector for Evidence, Redis for Ephemeral Session Memory)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/womens_health_ai
REDIS_URL=redis://localhost:6379/0


# Unverified fixtures are excluded unless explicitly enabled for software tests.
ALLOW_UNVERIFIED_EVIDENCE=false
