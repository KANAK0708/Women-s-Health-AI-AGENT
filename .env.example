GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Databases (PostgreSQL + pgvector for Evidence, Redis for Ephemeral Session Memory)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/womens_health_ai
REDIS_URL=redis://localhost:6379/0


# Unverified fixtures are excluded unless explicitly enabled for software tests.
ALLOW_UNVERIFIED_EVIDENCE=false

# Research agent (python3 -m health_tools.research "question" / Deep Research button)
# Groq plans + writes; Gemini reads long documents. Either key alone also works.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash
